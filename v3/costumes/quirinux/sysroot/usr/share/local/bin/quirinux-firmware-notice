#!/bin/bash
# Quirinux GNU/Linux - Post-wardrobe firmware notice
# Detects system language and prints installation instructions
# for quirinux-firmware (removed from wardrobe due to interactive
# license prompts that break unattended installation).

LANG_CODE=$(echo "${LANG:-en}" | cut -d_ -f1 | cut -d. -f1)

case "$LANG_CODE" in
  es)
    MSG="
┌─────────────────────────────────────────────────────────────────┐
│                    QUIRINUX GNU/LINUX                           │
│                                                                 │
│  El paquete quirinux-firmware (firmware privativo adicional     │
│  para tarjetas de red inalámbrica) no se instaló               │
│  automáticamente porque requiere aceptar licencias de uso.      │
│                                                                 │
│  Si lo necesitás, ejecutá:                                      │
│                                                                 │
│    apt install quirinux-firmware                                │
│                                                                 │
└─────────────────────────────────────────────────────────────────┘"
    ;;
  gl)
    MSG="
┌─────────────────────────────────────────────────────────────────┐
│                    QUIRINUX GNU/LINUX                           │
│                                                                 │
│  O paquete quirinux-firmware (firmware privativo adicional      │
│  para tarxetas de rede sen fíos) non se instalou               │
│  automaticamente porque require aceptar licenzas de uso.        │
│                                                                 │
│  Se o precisas, executa:                                        │
│                                                                 │
│    apt install quirinux-firmware                                │
│                                                                 │
└─────────────────────────────────────────────────────────────────┘"
    ;;
  it)
    MSG="
┌─────────────────────────────────────────────────────────────────┐
│                    QUIRINUX GNU/LINUX                           │
│                                                                 │
│  Il pacchetto quirinux-firmware (firmware proprietario          │
│  aggiuntivo per schede di rete wireless) non è stato           │
│  installato automaticamente perché richiede l'accettazione      │
│  di licenze d'uso.                                              │
│                                                                 │
│  Se ne hai bisogno, esegui:                                     │
│                                                                 │
│    apt install quirinux-firmware                                │
│                                                                 │
└─────────────────────────────────────────────────────────────────┘"
    ;;
  fr)
    MSG="
┌─────────────────────────────────────────────────────────────────┐
│                    QUIRINUX GNU/LINUX                           │
│                                                                 │
│  Le paquet quirinux-firmware (firmware propriétaire             │
│  supplémentaire pour cartes réseau sans fil) n'a pas été       │
│  installé automatiquement car il nécessite d'accepter des       │
│  licences d'utilisation.                                        │
│                                                                 │
│  Si vous en avez besoin, exécutez:                              │
│                                                                 │
│    apt install quirinux-firmware                                │
│                                                                 │
└─────────────────────────────────────────────────────────────────┘"
    ;;
  de)
    MSG="
┌─────────────────────────────────────────────────────────────────┐
│                    QUIRINUX GNU/LINUX                           │
│                                                                 │
│  Das Paket quirinux-firmware (zusätzliche proprietäre           │
│  Firmware für WLAN-Karten) wurde nicht automatisch              │
│  installiert, da es die Annahme von Nutzungslizenzen            │
│  erfordert.                                                     │
│                                                                 │
│  Falls Sie es benötigen, führen Sie aus:                        │
│                                                                 │
│    apt install quirinux-firmware                                │
│                                                                 │
└─────────────────────────────────────────────────────────────────┘"
    ;;
  hu)
    MSG="
┌─────────────────────────────────────────────────────────────────┐
│                    QUIRINUX GNU/LINUX                           │
│                                                                 │
│  A quirinux-firmware csomag (további saját firmware             │
│  vezeték nélküli hálózati kártyákhoz) nem települt             │
│  automatikusan, mert felhasználási licencek elfogadását         │
│  igényli.                                                       │
│                                                                 │
│  Ha szüksége van rá, futtassa:                                  │
│                                                                 │
│    apt install quirinux-firmware                                │
│                                                                 │
└─────────────────────────────────────────────────────────────────┘"
    ;;
  pt)
    MSG="
┌─────────────────────────────────────────────────────────────────┐
│                    QUIRINUX GNU/LINUX                           │
│                                                                 │
│  O pacote quirinux-firmware (firmware proprietário adicional    │
│  para placas de rede sem fio) não foi instalado                 │
│  automaticamente porque requer a aceitação de licenças          │
│  de utilização.                                                 │
│                                                                 │
│  Se precisar, execute:                                          │
│                                                                 │
│    apt install quirinux-firmware                                │
│                                                                 │
└─────────────────────────────────────────────────────────────────┘"
    ;;
  *)
    MSG="
┌─────────────────────────────────────────────────────────────────┐
│                    QUIRINUX GNU/LINUX                           │
│                                                                 │
│  The quirinux-firmware package (additional proprietary          │
│  firmware for wireless network cards) was not installed         │
│  automatically because it requires accepting usage licenses.    │
│                                                                 │
│  If you need it, run:                                           │
│                                                                 │
│    apt install quirinux-firmware                                │
│                                                                 │
└─────────────────────────────────────────────────────────────────┘"
    ;;
esac

echo "$MSG"
