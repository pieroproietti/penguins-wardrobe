# Quirinux preseed debconf selections

# Display Manager
lightdm shared/default-x-display-manager select lightdm
slim shared/default-x-display-manager select lightdm
gdm3 shared/default-x-display-manager select lightdm
sddm shared/default-x-display-manager select lightdm
xdm shared/default-x-display-manager select lightdm
nodm shared/default-x-display-manager select lightdm
lxdm shared/default-x-display-manager select lightdm

# Firmware non-free license acceptance
firmware-ipw2x00 firmware/ipw2x00/license/accepted boolean true
firmware-ipw2x00 firmware/ipw2x00/license/type select accept
firmware-ivtv firmware/ivtv/license/accepted boolean true
firmware-b43-installer firmware/b43/license/accepted boolean true
firmware-b43legacy-installer firmware/b43legacy/license/accepted boolean true
b43-fwcutter firmware/b43/install_non_free boolean true

# Paper configuration
libpaper libpaper/defaultpaper select a4

# CA Certificates
ca-certificates ca-certificates/trust_new_crts select yes

# Console & Keyboard configuration
console-setup console-setup/charmap47 select UTF-8
keyboard-configuration keyboard-configuration/layoutcode string es

# Firewall
ufw ufw/enable select true

# CUPS printing system
cups cups/raw-print boolean true
cups cups/backends multiselect lpd, socket, usb, snmp, dnssd

# Dictionaries
dictionaries-common dictionaries-common/default-ispell select castellano8 (Spanish 8 bit)
dictionaries-common dictionaries-common/default-wordlist select castellano (Spanish)

# Unattended upgrades
unattended-upgrades unattended-upgrades/enable_auto_updates boolean false
